# ==========================================================================
# AuraWell Health & Wellness Platform Environment Template
# Copy this file to .env and provide your production service keys.
# Never commit real credentials or service-role keys to source control.
# ==========================================================================

# 1. Supabase Backend & Database Connection
# Obtain from your Supabase Project Settings > API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_public_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_private_service_role_key_for_backend_jobs_only
DATABASE_URL=postgresql://postgres:your_db_password@db.your-project-ref.supabase.co:5432/postgres

# 2. Media & Video Transcoding Services
# Example: Cloudinary or Mux or Cloudflare Stream for short video delivery
MUX_TOKEN_ID=your_mux_token_id
MUX_TOKEN_SECRET=your_mux_token_secret
CLOUDFLARE_STREAM_ACCOUNT_ID=your_cloudflare_stream_account_id
CLOUDFLARE_STREAM_API_TOKEN=your_cloudflare_stream_token

# 3. Transactional Email & Push Notifications (OTP, Password Recovery)
# Example: Resend or SendGrid or Firebase Cloud Messaging
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=re_your_api_key
DEFAULT_FROM_EMAIL=no-reply@aurawell.org

# 4. Platform Security & DPDP Compliance
JWT_SECRET=super_secret_high_entropy_jwt_signing_key_min_64_characters
DPDP_AUDIT_LOG_RETENTION_DAYS=365
CORS_ALLOWED_ORIGINS=https://aurawell.org,https://admin.aurawell.org

# 5. Optional Ethical Monetization & Payment Processing (Razorpay / Stripe)
# Active only if ethical wellness memberships or certified consultations are enabled
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
STRIPE_PUBLIC_KEY=pk_live_your_key
STRIPE_SECRET_KEY=sk_live_your_key
